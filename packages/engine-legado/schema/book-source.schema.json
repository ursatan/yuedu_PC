        "updateTime": { "$ref": "#/$defs/ruleString", "title": "更新时间规则", "x-ui-visible": false, "x-ui-note": "Legado 无编辑框；在 Legado UI 保存一次会被静默清空（getSource() 用全新 SearchRule 整体替换）" },
        "bookUrl": { "$ref": "#/$defs/ruleString", "title": "详情页 URL 规则", "x-legacy-alias": "ruleSearchNoteUrl", "x-legacy-convert": "toNewRule" },
        "coverUrl": { "$ref": "#/$defs/ruleString", "title": "封面规则", "x-legacy-alias": "ruleSearchCoverUrl", "x-legacy-convert": "toNewRule" },
        "wordCount": { "$ref": "#/$defs/ruleString", "title": "字数规则" }
      }
