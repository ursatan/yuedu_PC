        "intro": { "$ref": "#/$defs/ruleString", "title": "简介规则", "x-legacy-alias": "ruleFindIntroduce", "x-legacy-convert": "toNewRule" },
        "kind": { "$ref": "#/$defs/ruleString", "title": "分类规则", "x-legacy-alias": "ruleFindKind", "x-legacy-convert": "toNewRule" },
        "lastChapter": { "$ref": "#/$defs/ruleString", "title": "最新章节规则", "x-legacy-alias": "ruleFindLastChapter", "x-legacy-convert": "toNewRule" },
        "updateTime": { "$ref": "#/$defs/ruleString", "title": "更新时间规则", "x-ui-visible": false },
        "bookUrl": { "$ref": "#/$defs/ruleString", "title": "详情页 URL 规则", "x-legacy-alias": "ruleFindNoteUrl", "x-legacy-convert": "toNewRule" },
        "coverUrl": { "$ref": "#/$defs/ruleString", "title": "封面规则", "x-legacy-alias": "ruleFindCoverUrl", "x-legacy-convert": "toNewRule" },
        "wordCount": { "$ref": "#/$defs/ruleString", "title": "字数规则" }
      }
